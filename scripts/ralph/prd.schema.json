{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RalphPRD",
  "type": "object",
  "required": ["project", "phase", "userStories"],
  "properties": {
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "lastUpdated": { "type": "string" },
    "userStories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "acceptanceCriteria", "passes"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "targetFiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "passes": { "type": "boolean" },
          "verificationCommand": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
