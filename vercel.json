{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bankscart.com"
        }
      ],
      "destination": "https://www.bankscart.com/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/blogs/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blogs-overview-page",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/credit-score/credit-rectification",
      "destination": "/credit-score/credit-rectification-service",
      "permanent": true
    },
    {
      "source": "/credit-score/cibil-for-loan",
      "destination": "/credit-score/cibil-score-for-personal-loan",
      "permanent": true
    },
    {
      "source": "/cards/lifetime-free",
      "destination": "/cards/credit/lifetime-free",
      "permanent": true
    },
    {
      "source": "/cards/cashback-credit-cards",
      "destination": "/cards/credit/cashback",
      "permanent": true
    },
    {
      "source": "/cards/secured-credit-card",
      "destination": "/cards/credit/secured",
      "permanent": true
    },
    {
      "source": "/company-registration/copyright",
      "destination": "/company-registration/copyright-registration",
      "permanent": true
    },
    {
      "source": "/company-registration/pvt-ltd",
      "destination": "/company-registration",
      "permanent": true
    },
    {
      "source": "/business-loan/company-reg-delhi",
      "destination": "/business-loan/company-registration-in-delhi",
      "permanent": true
    },
    {
      "source": "/business-loan/company-reg-blr",
      "destination": "/business-loan/company-registration-in-bangalore",
      "permanent": true
    },
    {
      "source": "/blog/Sukanya-Samriddhi-Yojana",
      "destination": "/blog/Sukanya-Samriddhi-Yojana-Guide",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    }
  ]
}